{
  "name": "receipt-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm ci --prefix editor && vite build editor --base=/editor/ --outDir ../dist/editor --emptyOutDir false",
    "preview": "vite preview",
    "start": "NODE_ENV=production node server.js",
    "test": "node --test"
  },
  "devDependencies": {
    "vite": "^7.3.7"
  },
  "dependencies": {
    "gifuct-js": "^2.1.2",
    "jsbarcode": "^3.12.3",
    "p5": "^2.3.3",
    "sharp": "^0.35.4",
    "three": "^0.186.0"
  },
  "engines": {
    "node": ">=20"
  }
}
